esphome:
  name: server-room-temp
  friendly_name: server-room-temp

rp2:
  board: rpipicow

logger:

api:
  encryption: 
    key: !secret api_key
ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  post_connect_roaming: true
  fast_connect: true

captive_portal:

packages:
  github: github://manicholls/esphome/common/rp2040.yaml


sensor:
  - platform: dht
    pin: GPIO3
    model: DHT11
    temperature:
      name: "Temperature"
    humidity:
      name: "Humidity"
    update_interval: 60s
